generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum Plan {
  MONTHLY
  YEARLY
  LIFETIME
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @db.VarChar(120)
  email        String            @unique @db.VarChar(255)
  passwordHash String            @map("password_hash")
  role         Role              @default(USER)
  plan         Plan              @default(MONTHLY)
  active       Boolean           @default(true)
  expiredAt    DateTime          @map("expired_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  snapshots    Snapshot[]
  results      Result[]
  analyses     AnalysisHistory[]
  logs         ActivityLog[]

  @@map("users")
}

model Snapshot {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(100)
  color     String   @db.VarChar(7)  @default("#3B82F6")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  results   Result[]
  analyses  AnalysisHistory[]

  @@unique([userId, title])
  @@index([userId, title])
  @@map("snapshots")
}

model Result {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  snapshotId   String   @map("snapshot_id") @db.Uuid
  resultNumber String   @map("result_number") @db.VarChar(4)
  drawDate     DateTime @map("draw_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot     Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, resultNumber, drawDate])
  @@index([snapshotId, drawDate])
  @@index([userId, drawDate])
  @@map("results")
}

model AnalysisHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  snapshotId   String   @map("snapshot_id") @db.Uuid
  analysisType String   @map("analysis_type") @db.VarChar(80)
  resultJson   Json     @map("result_json") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot     Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, createdAt])
  @@index([userId, createdAt])
  @@map("analysis_history")
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(180)
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("activity_logs")
}
